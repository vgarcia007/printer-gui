WEB_PORT=8081
APP_UID=1000
APP_GID=1000
TZ=Europe/Berlin
SCANNER_IP=192.0.2.30
SCANNER_MODEL=MFC-L2700DW
SCANS_HOST_DIR=./data/scans
JOBS_HOST_DIR=./data/jobs
PRINTER_CONFIG_FILE=./config/printers.local.json
SECRET_KEY=replace-with-a-long-random-value
# PDFs copied into JOBS_HOST_DIR are printed automatically after they have
# remained unchanged for this many seconds and contain a complete PDF trailer.
HOTFOLDER_ENABLED=true
HOTFOLDER_STABLE_SECONDS=15
HOTFOLDER_POLL_SECONDS=2
HOTFOLDER_RETRY_SECONDS=30
# Keep these at zero for a 1:1 DYMO 30321 preview. Change only after a measured test.
DYMO_LANDSCAPE_OFFSET_MM=0
DYMO_LANDSCAPE_SHRINK_MM=0
DYMO_LANDSCAPE_START_TRIM_MM=0
